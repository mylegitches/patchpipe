# Copy to .env and fill in your values. .env is gitignored.

# Shared Patchpipe LLM settings (used by all devices)
PATCHPIPE_LLM_BASE_URL=https://api.openai.com/v1
PATCHPIPE_LLM_API_KEY=
PATCHPIPE_LLM_MODEL=gpt-4o-mini
PATCHPIPE_OUTPUT_DIR=output

# Device-specific aliases are written automatically when you save from the UI.
# JUNO-DS also reads PATCHMAKER_LLM_* ; POD HD also reads AI_* keys.
